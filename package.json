{
  "name": "soundboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @soundboard/api dev",
    "dev:api:lan": "pnpm --filter @soundboard/api dev:lan",
    "dev:admin": "pnpm --filter @soundboard/admin dev",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "migrate:v1": "node scripts/migrate-v1.mjs",
    "brand:build": "node brand/scripts/build.mjs"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
