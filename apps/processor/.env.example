# Desarrollo sin Docker: copia a .env (`go run ./cmd/processor serve` lo lee).
PORT=8787
PROCESSOR_SECRET=el-mismo-secreto-que-en-la-api
# Opcional: ruta a un cookies.txt (exportado del navegador) para sitios que exigen sesión (YouTube, TikTok).
YTDLP_COOKIES=
# Solo en Docker local: URL de la API vista desde el contenedor (compose.yaml ya la define).
API_BASE_URL=
