# Copia a .env para desarrollo local (`go run ./cmd/api serve` lo lee automáticamente).
# En producción estas variables las genera Ansible (infra/ansible/roles/app/templates/api.env.j2).
ADDR=:8788
DATABASE_PATH=.data/soundboard.db
PROCESSOR_SECRET=cambia-esto-por-un-secreto-largo
PROCESSOR_URL=http://localhost:8790
GOOGLE_CLIENT_IDS=REEMPLAZAR.apps.googleusercontent.com
ADMIN_EMAILS=tu-correo@example.com
ADMIN_ORIGIN=http://localhost:5173

# Medios: con GCS_BUCKET van a Cloud Storage (credenciales de `gcloud auth application-default login`
# o la cuenta de servicio de la VM). Sin él, a MEDIA_DIR, servidos en /cdn si SERVE_MEDIA=true.
CDN_BASE_URL=
SERVE_MEDIA=true
MEDIA_DIR=.data/media
# GCS_BUCKET=

# Logs: LOG_FORMAT=text|json (en Docker es json) y LOG_LEVEL=debug|info|warn|error.
# LOG_FORMAT=text
# LOG_LEVEL=info
