{
  "$descripcion": "Fuente única de la identidad visual (hoy la de CastBerry). Edita este archivo y corre `node brand/scripts/build.mjs`; no edites brand/generated/ a mano.",
  "$origen": "Copiada de CastBerry (frontend/src/theme.css y style.css, DESIGN.md). Paleta fija de cuatro azules petróleo: snow = nieve, sage = salvia, deep = petróleo, ink = tinta.",
  "marca": {
    "nombre": "CastBerry",
    "paleta": {
      "snow": "#F3F4F4",
      "sage": "#5F9598",
      "deep": "#1D546D",
      "ink": "#061E29"
    }
  },
  "colores": {
    "$descripcion": "Roles de Material 3 (los usan CSS y Compose). El claro es el tema de entrada; el oscuro se elige a mano.",
    "claro": {
      "primary": "#1D546D",
      "onPrimary": "#FFFFFF",
      "secondary": "#5F9598",
      "onSecondary": "#061E29",
      "tertiary": "#061E29",
      "onTertiary": "#F3F4F4",
      "background": "#C7D7D8",
      "onBackground": "#061E29",
      "surface": "#F3F4F4",
      "onSurface": "#0C2A38",
      "surfaceVariant": "#E3E9EA",
      "onSurfaceVariant": "#3E5864",
      "outline": "#A3B9BC",
      "error": "#B3261E"
    },
    "oscuro": {
      "primary": "#F3F4F4",
      "onPrimary": "#061E29",
      "secondary": "#5F9598",
      "onSecondary": "#061E29",
      "tertiary": "#1D546D",
      "onTertiary": "#F3F4F4",
      "background": "#061E29",
      "onBackground": "#F3F4F4",
      "surface": "#0F3242",
      "onSurface": "#F3F4F4",
      "surfaceVariant": "#194A5D",
      "onSurfaceVariant": "#B3CDD1",
      "outline": "#2A5A6D",
      "error": "#FF8A80"
    }
  },
  "extensionWeb": {
    "$descripcion": "Roles que Material no define y la web sí usa: borde de campos (≥3:1), estados, texto de acento, foco, marca, progreso («lo que ya viste» va en salvia) y carátula vacía. Se emiten como --color-*.",
    "claro": {
      "outlineStrong": "#5A7480",
      "success": "#2E6B3F",
      "warning": "#8A5A00",
      "info": "#1D546D",
      "accentText": "#1D546D",
      "focus": "#1D546D",
      "brand": "#1D546D",
      "progress": "#5F9598",
      "progressPage": "#1D546D",
      "progressTrack": "color-mix(in srgb, #061E29 18%, transparent)",
      "posterEmpty": "#F3F4F4"
    },
    "oscuro": {
      "outlineStrong": "#6F9AA6",
      "success": "#8FD19E",
      "warning": "#FFD27A",
      "info": "#8FC2C4",
      "accentText": "#8FC2C4",
      "focus": "#F3F4F4",
      "brand": "#F3F4F4",
      "progress": "#5F9598",
      "progressPage": "#5F9598",
      "progressTrack": "color-mix(in srgb, #F3F4F4 10%, transparent)",
      "posterEmpty": "#194A5D"
    }
  },
  "franja": {
    "$descripcion": "Franja petróleo del tema claro (barra superior y cabecera): los mismos roles con valores de noche dentro de `.band`. En oscuro la franja es el fondo de la página.",
    "background": "#1D546D",
    "onBackground": "#F3F4F4",
    "surface": "#24607B",
    "onSurface": "#F3F4F4",
    "surfaceVariant": "#2A6680",
    "onSurfaceVariant": "#C9DCDF",
    "outline": "#3A7590",
    "outlineStrong": "#8FB4BF",
    "primary": "#F3F4F4",
    "onPrimary": "#061E29",
    "brand": "#F3F4F4",
    "accentText": "#A9D0D2",
    "focus": "#F3F4F4",
    "progressPage": "#A9D0D2",
    "progressTrack": "color-mix(in srgb, #F3F4F4 18%, transparent)",
    "posterEmpty": "#24607B"
  },
  "efectosWeb": {
    "$descripcion": "Variables CSS que no son roles de color; se emiten con su nombre tal cual. El reproductor y el texto sobre imágenes van sobre negro en ambos temas.",
    "comun": {
      "--on-light": "var(--palette-ink)",
      "--player-accent": "var(--palette-sage)",
      "--player-glow": "var(--palette-deep)",
      "--player-ground": "#03121a",
      "--scrim": "rgba(3, 18, 26, 0.94)",
      "--scrim-clear": "rgba(3, 18, 26, 0)",
      "--on-scrim": "#f3f4f4",
      "--on-scrim-muted": "#c3d6d8"
    },
    "claro": {
      "--backdrop-opacity": "0.3",
      "--ambient": "radial-gradient(120% 70% at 15% 0%, color-mix(in srgb, var(--palette-sage) 22%, transparent), transparent 70%)"
    },
    "oscuro": {
      "--backdrop-opacity": "0.5",
      "--ambient": "radial-gradient(120% 70% at 15% 0%, color-mix(in srgb, var(--palette-deep) 70%, transparent), transparent 70%)"
    },
    "franja": {
      "--backdrop-opacity": "0.45"
    }
  },
  "formas": {
    "small": 6,
    "medium": 8,
    "large": 14,
    "pill": 999
  },
  "tipografia": {
    "$descripcion": "Display Bricolage Grotesque (variable, auto-hospedada con @fontsource-variable/bricolage-grotesque) para marca y títulos; cuerpo en la sans del sistema. Sin mayúsculas en ningún texto. interlineado es proporción (1.5 = 150 %); espaciadoEm en em. `material` es la ranura de Typography en Compose (null = solo web).",
    "sans": ["system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"],
    "mono": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
    "display": ["Bricolage Grotesque Variable", "var(--font-sans)"],
    "estilos": {
      "display": { "familia": "display", "peso": 800, "tamano": 56, "tamanoCss": "clamp(2rem, 1.25rem + 3vw, 3.5rem)", "interlineado": 1.02, "espaciadoEm": -0.03, "material": "displayLarge" },
      "titleLarge": { "familia": "display", "peso": 700, "tamano": 22, "interlineado": 1.273, "espaciadoEm": -0.01, "material": "titleLarge" },
      "titleMedium": { "familia": "display", "peso": 700, "tamano": 20, "interlineado": 1.28, "espaciadoEm": -0.01, "material": "titleMedium" },
      "meta": { "familia": "sans", "peso": 600, "tamano": 16, "interlineado": 1.5, "espaciadoEm": 0, "material": null },
      "bodyLarge": { "familia": "sans", "peso": 400, "tamano": 16, "interlineado": 1.5, "espaciadoEm": 0, "material": "bodyLarge" },
      "labelMedium": { "familia": "sans", "peso": 600, "tamano": 12, "interlineado": 1.333, "espaciadoEm": 0.015, "material": "labelMedium" }
    }
  }
}
