# {{ ansible_managed }}
# DATABASE_PATH y ADDR vienen definidos en la imagen (/data/soundboard.db, :8788).
GOOGLE_CLIENT_IDS={{ google_client_ids }}
ADMIN_EMAILS={{ admin_emails }}
ADMIN_ORIGIN=https://{{ admin_domain }}
PROCESSOR_URL=http://processor:8787
PROCESSOR_SECRET={{ processor_secret }}
CDN_BASE_URL={{ cdn_base_url }}
# La API usa la cuenta de servicio de la VM (metadata server) para escribir en el bucket.
GCS_BUCKET={{ media_bucket }}
